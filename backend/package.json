{
  "name": "penguin-backend",
  "version": "1.0.0",
  "description": "Backend API for Penguin Men's Section",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "nodemon server.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:deploy": "prisma db push --accept-data-loss && node scripts/seedCleanBasics.js",
    "db:seed": "node scripts/seedCleanBasics.js",
    "db:setup": "prisma db push --accept-data-loss && prisma generate && node scripts/seedCleanBasics.js",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  name                String    @default("Atelier Administrator")
  email               String    @unique
  password            String
  role                String    @default("customer") // customer | admin | superadmin
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  tempPassword        Boolean   @default(false)
  lastLoginAt         DateTime?
  backupCodes         Json?     // Array of hashed recovery strings
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

model Customer {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  phone               String?        @unique
  password            String
  emailVerified       Boolean        @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  resetToken          String?
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  addresses           Address[]
  orders              Order[]
  wishlist            WishlistItem[]
  cart                CartItem[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String?  // "Home", "Office"
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(uuid())
  slug             String    @unique
  name             String
  category         String
  categoryId       String?
  color            String?
  price            Float
  originalPrice    Float?
  badge            String?
  images           Json      @default("[]")
  sizes            Json      @default("[]")
  colorVariants    Json?     @default("[]")
  isFeatured       Boolean   @default(false)
  isWinterDrop     Boolean   @default(false)
  inStock          Boolean   @default(true)
  stock            Int       @default(50)
  stockStatus      String    @default("In Stock")
  fabricDetails    String?
  careInstructions String?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  categoryRel      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("products")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String?     @unique
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?
  customerName    String?
  email           String?
  phone           String?
  items           OrderItem[]
  subtotal        Float
  shippingFee     Float       @default(0)
  discount        Float       @default(0)
  total           Float
  status          String      @default("pending") // pending | paid | shipped | delivered | cancelled | failed
  orderStatus     String      @default("Processing")
  shippingAddress Json
  paymentProvider   String      @default("razorpay")
  paymentMethod     String      @default("razorpay")
  paymentStatus     String      @default("initiated") // initiated | success | failed | pending
  merchantTxnId     String?     @unique // what you send to PhonePe / custom reference
  phonepeTxnId      String?     // what PhonePe sends back
  razorpayOrderId   String?     @unique // Razorpay Order ID (order_xxx)
  razorpayPaymentId String?     // Razorpay Payment ID (pay_xxx)
  razorpaySignature String?     // Razorpay Verification Signature
  trackingNumber    String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  name      String
  price     Float
  size      String?
  color     String?
  quantity  Int

  @@map("order_items")
}

model CartItem {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  productId  String
  size       String?
  color      String?
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId, size, color])
  @@map("cart_items")
}

model WishlistItem {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model SiteConfig {
  id                 String   @id @default(uuid())
  marqueeText        String?
  archiveText        String?
  heroHeadline       String?
  heroSubheadline    String?
  heroImage          String?
  heroDropTag        String?
  heroSlides         Json?    @default("[]")
  promotionalDrops   Json?    @default("[]")
  showWinterDrop     Boolean  @default(true)
  enableCod          Boolean  @default(true)
  winterDropTitle    String?
  winterDropSubtitle String?
  winterDropCta      String?
  winterDropImage    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_configs")
}
